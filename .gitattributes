# Keep generated bytes reproducible on Windows, including UTF-8 BOM files.
tools/*.py text eol=lf
tools/*.json text eol=lf
tools/*.mjs text eol=lf
docs/*.json text eol=lf
docs/*.csv text eol=lf
AuraClash/common/**/ac_event*.txt text eol=lf
AuraClash/common/**/ac_activity*.txt text eol=lf
AuraClash/common/**/ac_sect*.txt text eol=lf
AuraClash/events/ac_sect*.txt text eol=lf
AuraClash/localization/english/ac_sect*.yml text eol=lf
AuraClash/localization/replace/ac_sect*.yml text eol=lf
AuraClash/gui/ac_sect*.gui text eol=lf
AuraClash/gui/scripted_widgets/ac_sect*.txt text eol=lf
AuraClash/localization/english/ac_event_options_l_english.yml text eol=lf
